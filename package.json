{
  "name": "teamspace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/run-framework.mjs build",
    "build:pilot": "node node_modules/vite/bin/vite.js build --config pilot/vite.config.ts",
    "start:pilot": "bash scripts/pilot-lock.sh \"${TEAMSPACE_DATA_DIR:?Set an absolute TEAMSPACE_DATA_DIR}\" node --import tsx server/pilot.ts",
    "pilot:backup": "node scripts/pilot-backup.mjs backup",
    "pilot:restore": "node scripts/pilot-backup.mjs restore",
    "pilot:rehearsal": "node --import tsx scripts/pilot-migration.mjs",
    "pilot:jira:collect": "node --import tsx scripts/jira-pilot-collect.mjs",
    "pilot:confluence:audit": "node --import tsx scripts/confluence-pilot-audit.mjs",
    "test:pilot": "npm run build:pilot && node --test tests/ops/pilot-backup.test.mjs && node scripts/test-pilot.mjs",
    "test:pilot:team": "npm run build:pilot && node scripts/test-pilot.mjs --team",
    "test:pilot:access": "npm run build:pilot && node scripts/test-pilot-access.mjs",
    "test:pilot:rehearsal": "npm run build:pilot && node --test tests/ops/pilot-migration.test.mjs tests/ops/pilot-migration-profile.test.mjs tests/ops/pilot-migration-confluence-findings.test.mjs tests/ops/jira-pilot-collect-plan-rehearsal.test.mjs",
    "test:pilot:rehearsal:scale": "npm run build:pilot && node --test tests/ops/pilot-migration-scale.test.mjs",
    "test:pilot:jira": "node --import tsx --test tests/ops/jira-pilot-collect.test.mjs",
    "test:pilot:confluence": "node --import tsx --test tests/ops/confluence-pilot-audit.test.mjs",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "dev:web": "node scripts/run-framework.mjs dev",
    "dev:api": "tsx watch server/index.ts",
    "test": "tsx --test tests/server/*.test.ts",
    "typecheck": "tsc --noEmit",
    "start:api": "tsx server/index.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "marked": "18.2.1",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "@tiptap/extension-table": "3.34.0",
    "@tiptap/extension-task-list": "3.34.0",
    "@tiptap/extension-task-item": "3.34.0",
    "@tiptap/extension-placeholder": "3.34.0",
    "@tiptap/extension-image": "3.34.0",
    "express": "5.1.0",
    "yjs": "13.6.33",
    "y-prosemirror": "1.3.7",
    "ws": "8.23.0",
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-collaboration": "3.34.0",
    "@tiptap/y-tiptap": "3.3.0",
    "fast-xml-parser": "5.12.1",
    "yazl": "3.3.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "@types/express": "5.0.3",
    "tsx": "4.20.6",
    "@playwright/test": "1.56.1",
    "@types/ws": "8.18.1",
    "@types/yauzl": "3.4.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "description": "\ud300 \ud504\ub85c\uc81d\ud2b8\uc640 \uc9c0\uc2dd\uc744 \uc5f0\uacb0\ud558\ub294 \ub3c5\ub9bd \uc5c5\ubb34 \ub3c4\uad6c"
}
